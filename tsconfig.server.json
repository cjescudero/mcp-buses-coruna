{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": ["main.ts", "server.ts", "catalog.ts", "stop-search.ts", "scripts/update-catalog.ts"]
}
